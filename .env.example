# ==============================================================================
# KrishiSetu AI - Environment Configuration Template
# Copy this file to .env and customize values for local development.
# NEVER commit the actual .env file or real credentials to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:19006

# Security & Authentication (Generate a secure secret key for production)
SECRET_KEY=change-this-insecure-key-to-a-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default to local SQLite for rapid Phase 0-2 development; easily migrated to PostgreSQL
DATABASE_URL=sqlite:///./backend/krishisetu.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://krishi_user:password@localhost:5432/krishisetu_db

# Weather Service Configuration
# Initial provider candidate: Open-Meteo (requires no API key for standard non-commercial usage)
WEATHER_PROVIDER=open-meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=3600
WEATHER_REQUEST_TIMEOUT_SECONDS=10
# Future external provider keys (to be verified during implementation):
WEATHER_API_KEY=

# Machine Learning & Inference Settings
MODEL_WEIGHTS_PATH=models/resnet18_plantvillage.pt
# Minimum confidence threshold (0.0 to 1.0) below which prediction is marked uncertain
MODEL_CONFIDENCE_THRESHOLD=0.60
INFERENCE_DEVICE=cpu

# Multilingual & Voice / TTS Configuration (To be verified during implementation)
DEFAULT_LANGUAGE=en
TTS_PROVIDER=browser_native
# TTS_API_KEY=

# Storage for Field Uploads
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
